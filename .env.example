# Public origin of the storefront, no trailing slash. Used for canonical URLs,
# hreflang, Open Graph, JSON-LD and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Internal URL the Next.js server uses to reach the API (server-side only)
API_URL=http://localhost:4000
# Public origin that serves uploaded images (defaults to API_URL)
MEDIA_URL=https://api.example.com
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token (content value only). Optional.
GOOGLE_SITE_VERIFICATION=
